# NookScout local environment template
# Copy values into a local .env file when settings are scaffolded.
# Never commit real API keys, provider tokens, database credentials, or private watchlists.

# Selected market data provider for STORY-001.
NOOKSCOUT_MARKET_DATA_PROVIDER=massive

# Massive / Polygon.io market data.
# Use a local secret value in .env, not in this template.
MASSIVE_API_KEY=replace_with_your_massive_api_key
MASSIVE_API_BASE_URL=https://api.polygon.io
MASSIVE_STOCKS_PLAN=starter
MASSIVE_DATA_RECENCY=delayed
MASSIVE_REQUEST_TIMEOUT_SECONDS=30
MASSIVE_MAX_RETRIES=3
